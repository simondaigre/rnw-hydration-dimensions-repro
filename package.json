{
  "name": "rnw-hydration-dimensions-repro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --web",
    "build": "expo export -p web",
    "serve": "expo serve --port 8081",
    "check": "node scripts/check-hydration.mjs http://localhost:8081/",
    "fix": "patch -p1 --forward -d node_modules/react-native-web < fix.patch",
    "unfix": "patch -p1 -R -d node_modules/react-native-web < fix.patch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-server": "~58.0.6",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "puppeteer-core": "24"
  }
}
